{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/update-github-stats.ts && VITE_VERCEL_ENV=\"${VERCEL_ENV:-}\" vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "lint:e2e": "eslint 'e2e/**/*.{ts,tsx}' --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:functional": "playwright test --project=functional",
    "test:e2e:visual": "playwright test --config playwright.visual.config.ts",
    "test:e2e:prod-contract": "playwright test --config playwright.prod-contract.config.ts",
    "test:e2e:preview-contract": "playwright test --config playwright.preview-contract.config.ts",
    "test:e2e:update-baselines": "docker run --rm -v \"$PWD:/work\" -w /work mcr.microsoft.com/playwright:v1.58.2-jammy sh -c 'npm ci --legacy-peer-deps && npx playwright install --with-deps chromium && npm run build && npx playwright test --config playwright.visual.config.ts --update-snapshots=changed'",
    "design:validate": "tsx scripts/design-validate.ts",
    "design:status": "tsx scripts/design-status.ts",
    "design:apply": "tsx scripts/design-apply.ts",
    "design:archive": "tsx scripts/design-archive.ts",
    "design:assert-stripped": "tsx scripts/assert-design-companion-stripped.ts",
    "build:check": "VITE_VERCEL_ENV=\"\" vite build"
  },
